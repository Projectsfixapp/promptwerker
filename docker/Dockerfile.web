# Next.js-App (Verzeichnis web/) für den Betrieb auf dem eigenen Server.
# Bewusst getrennt von docker/Dockerfile — das ist das alte WordPress-Image
# aus der verworfenen Render-Variante und wird hier nicht angefasst.

FROM node:22-alpine AS deps
WORKDIR /app
COPY web/package.json web/package-lock.json ./
# `npm ci` statt `npm install`: reproduzierbar aus der Lockdatei.
RUN npm ci

FROM node:22-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY web/ ./
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

# Nicht als root laufen lassen
RUN addgroup -g 1001 -S nodejs && adduser -u 1001 -S nextjs -G nodejs

# Die Standalone-Ausgabe bringt server.js und die nötigen Abhängigkeiten mit.
# `public` und `.next/static` legt Next bewusst NICHT hinein — hier von Hand
# an die Stellen kopieren, an denen server.js sie erwartet.
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/public ./public

USER nextjs
EXPOSE 3000

# Kein Healthcheck-Endpunkt in der App: die Startseite ist statisch
# vorgerendert und beantwortet die Prüfung ohne Zusatzcode.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3000/ >/dev/null 2>&1 || exit 1

CMD ["node", "server.js"]
